<!-- sections/sweets-hero.liquid -->
{%- liquid
  assign se_stts = section.settings
  assign image = se_stts.image
  assign hero_collection = se_stts.collection | default: collections['bestseller-boxen']
  assign hero_product = hero_collection.products.first
  assign use_product_image = false
  if image == blank and hero_product.featured_image != blank and se_stts.use_theme_image != true
    assign image = hero_product.featured_image
    assign use_product_image = true
  endif
  assign image_mobile = se_stts.image_mobile | default: image
  assign image_2 = se_stts.image_secondary_1
  assign image_3 = se_stts.image_secondary_2
  assign is_collage = false
  if image_2 != blank or image_3 != blank
    assign is_collage = true
  endif
  if se_stts.use_theme_image
    assign is_collage = false
  endif
-%}
<section class="sweets-hero{% if use_product_image %} sweets-hero--product{% elsif is_collage %} sweets-hero--collage{% else %} sweets-hero--bg{% endif %}{% if se_stts.use_theme_image %} sweets-hero--theme-image{% endif %}" data-section-id="{{ section.id }}" data-section-type="sweets-hero">
  {%- unless is_collage or use_product_image -%}
    {%- if image or image_mobile or se_stts.use_theme_image -%}
      <div class="sweets-hero__bg" aria-hidden="true">
        {%- if se_stts.use_theme_image -%}
          <img src="{{ 'hero.png' | asset_url }}" width="1672" height="941" alt="" class="sweets-hero__bg-image" loading="eager" fetchpriority="high">
        {%- else -%}
        <picture>
          {%- if image_mobile != blank -%}
            <source media="(max-width: 699px)" srcset="{{ image_mobile | image_url: width: 400 }} 400w, {{ image_mobile | image_url: width: 700 }} 700w, {{ image_mobile | image_url: width: 1000 }} 1000w" sizes="100vw">
          {%- endif -%}
          {%- assign desktop_image = image | default: image_mobile -%}
          {{ desktop_image | image_url: width: 1600 | image_tag: widths: '700, 1200, 1600, 2000', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'sweets-hero__bg-image' }}
        </picture>
        {%- endif -%}
        <div class="sweets-hero__scrim"></div>
      </div>
    {%- endif -%}
  {%- endunless -%}
  <div class="sweets-container sweets-hero__inner">
    <div class="sweets-hero__content">
      {%- if se_stts.eyebrow != blank -%}<p class="sweets-hero__eyebrow">{{ se_stts.eyebrow | escape }}</p>{%- endif -%}
      {%- if se_stts.heading != blank -%}
        <h1 class="sweets-hero__heading">{{ se_stts.heading }}</h1>
      {%- endif -%}
      {%- if se_stts.subheading != blank -%}
        <p class="sweets-hero__subheading">{{ se_stts.subheading }}</p>
      {%- endif -%}
      {%- if se_stts.primary_cta_link != blank or se_stts.secondary_cta_link != blank -%}
        <div class="sweets-hero__ctas">
          {%- if se_stts.primary_cta_link != blank and se_stts.primary_cta_label != blank -%}
            <a href="{{ se_stts.primary_cta_link }}" class="sweets-btn sweets-btn--primary">{{ se_stts.primary_cta_label }}</a>
          {%- endif -%}
          {%- if se_stts.secondary_cta_link != blank and se_stts.secondary_cta_label != blank -%}
            <a href="{{ se_stts.secondary_cta_link }}" class="sweets-btn sweets-btn--secondary">{{ se_stts.secondary_cta_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if use_product_image -%}
      <div class="sweets-hero__showcase">
        <span class="sweets-hero__orbit" aria-hidden="true">✦</span>
        <a class="sweets-hero__product-link" href="{{ hero_product.url }}">
          {{ image | image_url: width: 1000 | image_tag: widths: '360, 540, 750, 1000', sizes: '(min-width: 990px) 45vw, 90vw', loading: 'eager', fetchpriority: 'high', class: 'sweets-hero__product-image', alt: hero_product.title }}
          <span class="sweets-hero__product-caption">{{ hero_collection.title | escape }} <span aria-hidden="true">↗</span></span>
        </a>
        <span class="sweets-hero__stamp">Dein nächstes<br>Nasch-Abenteuer</span>
      </div>
    {%- endif -%}

    {%- if is_collage -%}
      <div class="sweets-hero__media sweets-hero__media--collage">
        {%- if image -%}
          <div class="sweets-hero__collage-item sweets-hero__collage-item--main">
            <img
              srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 990px) 30vw, 60vw"
              src="{{ image | image_url: width: 900 }}"
              width="{{ image.width }}"
              height="{{ image.height }}"
              alt="{{ image.alt | escape }}"
              loading="eager"
              fetchpriority="high"
            >
          </div>
        {%- endif -%}
        {%- if image_2 -%}
          <div class="sweets-hero__collage-item">
            <img
              srcset="{{ image_2 | image_url: width: 500 }} 500w, {{ image_2 | image_url: width: 700 }} 700w"
              sizes="(min-width: 990px) 20vw, 40vw"
              src="{{ image_2 | image_url: width: 600 }}"
              width="{{ image_2.width }}"
              height="{{ image_2.height }}"
              alt="{{ image_2.alt | escape }}"
              loading="eager"
            >
          </div>
        {%- endif -%}
        {%- if image_3 -%}
          <div class="sweets-hero__collage-item">
            <img
              srcset="{{ image_3 | image_url: width: 500 }} 500w, {{ image_3 | image_url: width: 700 }} 700w"
              sizes="(min-width: 990px) 20vw, 40vw"
              src="{{ image_3 | image_url: width: 600 }}"
              width="{{ image_3.width }}"
              height="{{ image_3.height }}"
              alt="{{ image_3.alt | escape }}"
              loading="eager"
            >
          </div>
        {%- endif -%}
        {%- if se_stts.collage_tag != blank -%}
          <div class="sweets-hero__collage-tag">{{ se_stts.collage_tag }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sweets Hero",
  "tag": "section",
  "class": "sweets-hero-section",
  "settings": [
    { "type": "checkbox", "id": "use_theme_image", "label": "Mitgelieferte hero.png verwenden", "default": false, "info": "Verwendet assets/hero.png statt der unten ausgewählten Bilder." },
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift", "default": "Kleine Box. Große Welt." },
    { "type": "collection", "id": "collection", "label": "Hero-Produkte", "info": "Ohne Hauptbild wird das erste Produkt dieser Kollektion gezeigt." },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "NASCH DICH UM DIE WELT."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Unterzeile",
      "default": "Entdecke internationale Süßigkeiten, besondere Snacks und deine nächsten Lieblingssorten."
    },
    {
      "type": "header",
      "content": "Bild"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hauptbild"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Bild (Mobil, nur bei Einzelbild-Modus)",
      "info": "Wenn leer, wird das Hauptbild verwendet. Wird ignoriert, sobald ein Collage-Nebenbild gesetzt ist."
    },
    {
      "type": "image_picker",
      "id": "image_secondary_1",
      "label": "Collage-Nebenbild 1 (optional)",
      "info": "Sobald hier oder bei Nebenbild 2 ein Bild gesetzt ist, wechselt die Section in den Collage-Modus (Hauptbild groß + Nebenbilder gestapelt)."
    },
    {
      "type": "image_picker",
      "id": "image_secondary_2",
      "label": "Collage-Nebenbild 2 (optional)"
    },
    {
      "type": "text",
      "id": "collage_tag",
      "label": "Sticker-Text auf der Collage (optional)",
      "info": "Nur im Collage-Modus sichtbar."
    },
    {
      "type": "header",
      "content": "Call-to-Actions"
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primärer Button-Text",
      "default": "Bestseller entdecken"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primärer Button-Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Sekundärer Button-Text",
      "default": "Boxen shoppen"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Sekundärer Button-Link"
    }
  ],
  "presets": [
    {
      "name": "Sweets Hero"
    }
  ]
}
{% endschema %}
