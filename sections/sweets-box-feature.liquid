<!-- sections/sweets-box-feature.liquid -->
{%- liquid
  assign se_stts = section.settings
  assign image = se_stts.image | default: se_stts.collection.products.first.featured_image
  assign layout_class = 'sweets-box-feature--image-' | append: se_stts.image_position
-%}
<section class="sweets-box-feature {{ layout_class }}" data-section-id="{{ section.id }}" data-section-type="sweets-box-feature">
  <div class="sweets-container sweets-box-feature__inner">
    <div class="sweets-box-feature__media">
      {%- if image -%}
        <img
          src="{{ image | image_url: width: 900 }}"
          srcset="{{ image | image_url: width: 500 }} 500w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1300 }} 1300w"
          sizes="(min-width: 990px) 50vw, 100vw"
          width="{{ image.width }}"
          height="{{ image.height }}"
          alt="{{ image.alt | escape }}"
          loading="lazy"
        >
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'sweets-box-feature__placeholder' }}
      {%- endif -%}
    </div>
    <div class="sweets-box-feature__content">
      {%- if se_stts.heading != blank -%}
        <h2 class="sweets-section-heading">{{ se_stts.heading }}</h2>
      {%- endif -%}
      {%- if se_stts.text != blank -%}
        <div class="sweets-box-feature__text sweets-rte">{{ se_stts.text }}</div>
      {%- endif -%}
      {%- if se_stts.cta_link != blank and se_stts.cta_label != blank -%}
        <a href="{{ se_stts.cta_link }}" class="sweets-btn sweets-btn--primary">{{ se_stts.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sweets Boxen-Highlight",
  "tag": "section",
  "class": "sweets-box-feature-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Die Welt in einer Box."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Bildposition (Desktop)",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button-Text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button-Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection für das Ersatzbild"
    }
  ],
  "presets": [
    {
      "name": "Sweets Boxen-Highlight"
    }
  ]
}
{% endschema %}
