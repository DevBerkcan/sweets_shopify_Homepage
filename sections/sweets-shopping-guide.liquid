{% liquid
  assign product_blocks = section.blocks | where: 'type', 'product'
  assign budget = section.settings.budget | times: 100
%}
{% if product_blocks.size > 0 or request.design_mode %}
{{ 'sweets-shopping-guide.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sweets-shopping-guide.js' | asset_url }}" defer></script>
<sweets-shopping-guide id="sweets-shopping-guide-{{ section.id }}" class="sw-guide sweets-container">
  <div class="sw-guide__questions" hidden data-questions>
    <h2 class="sweets-section-heading">{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.intro | escape }}</p>
    <form data-guide-form>
      <fieldset data-step="0">
        <legend tabindex="-1">{{ 'sweets.guide.interest' | t }}</legend>
        <div class="sw-guide__choices">
          <label><input type="radio" name="interest" value="all" checked> {{ 'sweets.guide.any' | t }}</label>
          {% assign categories = section.blocks | map: 'settings' | map: 'category' | uniq %}
          {% for category in categories %}{% if category != blank %}
            <label><input type="radio" name="interest" value="{{ category | escape }}"> {{ category | escape }}</label>
          {% endif %}{% endfor %}
        </div>
        <button type="button" class="sweets-btn sweets-btn--primary" data-next>{{ 'sweets.guide.next' | t }}</button>
      </fieldset>
      <fieldset data-step="1" hidden>
        <legend tabindex="-1">{{ 'sweets.guide.budget' | t }}</legend>
        <div class="sw-guide__choices">
          <label><input type="radio" name="budget" value="0" checked> {{ 'sweets.guide.any_budget' | t }}</label>
          <label><input type="radio" name="budget" value="{{ budget }}"> {{ 'sweets.guide.up_to' | t }} {{ budget | money_with_currency }}</label>
          <label><input type="checkbox" name="available" checked> {{ 'sweets.guide.available_only' | t }}</label>
        </div>
        <button type="button" class="sweets-btn sweets-btn--secondary" data-back>{{ 'sweets.guide.back' | t }}</button>
        <button type="submit" class="sweets-btn sweets-btn--primary">{{ 'sweets.guide.show' | t }}</button>
      </fieldset>
    </form>
  </div>
  <div data-results>
    <h2 class="sweets-section-heading" tabindex="-1" data-results-title>{{ section.settings.results_heading | escape }}</h2>
    <p data-empty hidden>{{ 'sweets.guide.empty' | t }}</p>
    <div class="sw-guide__products">
      {% assign rendered_ids = '' %}
      {% for block in product_blocks %}
        {% liquid
          assign item = block.settings.product
          assign item_key = item.id | prepend: '|' | append: '|'
          if item == blank or rendered_ids contains item_key
            continue
          endif
          assign rendered_ids = rendered_ids | append: item_key
        %}
        <article class="sw-guide__product" data-item data-id="{{ item.id }}" data-category="{{ block.settings.category | escape }}" data-price="{{ item.price }}" data-available="{{ item.available }}" {{ block.shopify_attributes }}>
          <a href="{{ item.url }}" class="sw-guide__image">
            {% if item.featured_image %}{{ item.featured_image | image_url: width: 500 | image_tag: widths: '250,400,500', sizes: '(min-width: 1000px) 22vw, 45vw', loading: 'lazy', alt: item.title }}{% else %}{% render 'product-img', image: item.featured_image %}{% endif %}
          </a>
          <div class="sw-guide__body">
            <h3><a href="{{ item.url }}">{{ item.title | escape }}</a></h3>
            <div>{% render 'product-price', product: item, price_varies_style: settings.price_varies_style %}</div>
            {% unless item.available %}<p>{{ 'products.product.sold_out' | t }}</p>{% endunless %}
            <a class="sweets-btn sweets-btn--primary" href="{{ item.url }}">{{ 'products.product_card.view' | t }}</a>
            <label data-compare-control hidden><input type="checkbox" data-compare value="{{ item.id }}"> {{ 'sweets.guide.compare' | t }}</label>
          </div>
          <template data-comparison>
            <div class="sw-guide__comparison-card">
              <h3><a href="{{ item.url }}">{{ item.title | escape }}</a></h3>
              <dl>
                <div><dt>{{ 'sweets.guide.price' | t }}</dt><dd>{% render 'product-price', product: item, price_varies_style: settings.price_varies_style %}</dd></div>
                <div><dt>{{ 'sweets.guide.category' | t }}</dt><dd>{{ block.settings.category | default: item.type | escape }}</dd></div>
                <div><dt>{{ 'sweets.guide.availability' | t }}</dt><dd>{% if item.available %}{{ 'sweets.guide.available' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</dd></div>
              </dl>
              {% render 'sweets-product-facts', product: item %}
              <a class="sw-text-link" href="{{ item.url }}">{{ 'products.product_card.view' | t }}</a>
              <button type="button" class="sw-text-link" data-remove="{{ item.id }}">{{ 'sweets.guide.remove' | t }}</button>
            </div>
          </template>
        </article>
      {% endfor %}
    </div>
  </div>
  <button class="sweets-btn sweets-btn--secondary" type="button" data-reset hidden>{{ 'sweets.guide.restart' | t }}</button>
  <section class="sw-guide__comparison" data-comparison-section hidden aria-labelledby="compare-title-{{ section.id }}">
    <h2 class="sweets-section-heading" id="compare-title-{{ section.id }}">{{ section.settings.compare_heading | escape }}</h2>
    <p>{{ 'sweets.guide.compare_help' | t }}</p>
    <p data-status role="status" aria-live="polite" data-count-text="{{ 'sweets.guide.count' | t | escape }}" data-empty-text="{{ 'sweets.guide.compare_empty' | t | escape }}"></p>
    <div class="sw-guide__comparison-grid" data-comparison-grid></div>
    <button class="sweets-btn sweets-btn--secondary" type="button" data-clear hidden>{{ 'sweets.guide.clear' | t }}</button>
  </section>
</sweets-shopping-guide>
{% endif %}
{% schema %}
{
  "name": "Sweets Finder & Vergleich",
  "settings": [
    {"type":"text","id":"heading","label":"Überschrift","default":"Finde deinen nächsten Lieblingsmoment."},
    {"type":"text","id":"intro","label":"Einleitung","default":"Zwei Fragen führen dich zu passenden Kalendern und Boxen."},
    {"type":"text","id":"results_heading","label":"Ergebnis-Überschrift","default":"Deine Auswahl"},
    {"type":"text","id":"compare_heading","label":"Vergleich-Überschrift","default":"Deine Favoriten im Vergleich"},
    {"type":"range","id":"budget","label":"Budget-Grenze","min":10,"max":100,"step":5,"default":30,"info":"Betrag in der aktuell angezeigten Währung. Verglichen wird der niedrigste Produktpreis, ohne Bundle-Rabatte."}
  ],
  "blocks":[{"type":"product","name":"Produkt","settings":[
    {"type":"product","id":"product","label":"Produkt"},
    {"type":"text","id":"category","label":"Interesse / Kategorie","info":"Zum Beispiel Tee, USA oder Asia. Gleiche Schreibweise gruppiert Produkte."}
  ]}],
  "max_blocks":12,
  "presets":[{"name":"Sweets Finder & Vergleich"}]
}
{% endschema %}
