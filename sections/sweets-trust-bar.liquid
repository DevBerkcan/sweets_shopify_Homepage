<!-- sections/sweets-trust-bar.liquid -->
<section class="sweets-trust-bar" data-section-id="{{ section.id }}" data-section-type="sweets-trust-bar">
  <div class="sweets-container sweets-trust-bar__inner">
    {%- for block in section.blocks -%}
      {%- if block.settings.text != blank -%}
        <div class="sweets-trust-bar__fact" {{ block.shopify_attributes }}>
          <span class="sweets-trust-bar__dot" aria-hidden="true"></span>{{ block.settings.text }}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Sweets Trust-Leiste",
  "tag": "section",
  "class": "sweets-trust-bar-section",
  "settings": [],
  "blocks": [
    {
      "type": "fact",
      "name": "Fakt",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Sweets Trust-Leiste",
      "blocks": [
        { "type": "fact", "settings": { "text": "Versand in 2–5 Werktagen" } },
        { "type": "fact", "settings": { "text": "Kostenloser Versand ab 40,00 €" } },
        { "type": "fact", "settings": { "text": "Snacks aus über 20 Ländern" } },
        { "type": "fact", "settings": { "text": "14 Tage Rückgabe (ungeöffnet)" } }
      ]
    }
  ]
}
{% endschema %}
