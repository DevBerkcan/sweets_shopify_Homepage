{% style %}
  @font-face { font-family: 'Sweets Manrope'; src: url('{{ 'sweets-manrope.woff2' | asset_url }}') format('woff2'); font-weight: 400 800; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Sweets Cormorant'; src: url('{{ 'sweets-cormorant-garamond.woff2' | asset_url }}') format('woff2'); font-weight: 400 700; font-style: normal; font-display: swap; }
  :root {
    --sw-paper: {{ settings.sweets_paper | default: '#fffdf8' }};
    --sw-pine: {{ settings.sweets_pine | default: '#14392f' }};
    --sw-gold: {{ settings.sweets_gold | default: '#e3c868' }};
  }
{% endstyle %}
{{ 'sweets-premium.css' | asset_url | stylesheet_tag }}
{{ 'sweets-commerce.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sweets-drawer-focus.js' | asset_url }}" defer></script>
